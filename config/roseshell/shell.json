{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "roseshell.clock",
    "layout": {
      "left": [
        {
          "id": "roseshell.menu"
        },
        {
          "id": "roseshell.workspaces"
        }
      ],
      "center": [
        {
          "id": "roseshell.indicators"
        },
        {
          "id": "roseshell.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "roseshell.keyboard-layout"
        },
        {
          "id": "roseshell.weather"
        },
        {
          "id": "roseshell.system-update"
        }
      ],
      "right": [
        {
          "id": "roseshell.tray"
        },
        {
          "id": "roseshell.agents"
        },
        {
          "id": "roseshell.bluetooth"
        },
        {
          "id": "roseshell.network"
        },
        {
          "id": "roseshell.audio"
        },
        {
          "id": "roseshell.monitor"
        },
        {
          "id": "roseshell.power"
        }
      ]
    }
  },
  "plugins": []
}
