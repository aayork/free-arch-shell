#!/bin/bash
# roseshell:summary=Install and manage free-arch-shell plugins from the command line
# roseshell:args=<add|enable|disable|remove|list> [args...]
# roseshell:examples=roseshell-plugin add https://github.com/Owaisshaikh11/omarchy-session-menu.git --enable
#                   roseshell-plugin enable bo.omacast
#                   roseshell-plugin disable owaiss.session-menu
#                   roseshell-plugin remove owaiss.session-menu
#                   roseshell-plugin list
#
# Mirrors real Omarchy's own `omarchy plugin add/enable/...` subcommand
# (see the omacast integration notes) as its own standalone script, plumbed
# into the `roseshell plugin ...` group of this fork's own command center.
#
# Plugins are just a directory at ~/.config/roseshell/plugins/<manifest id>/
# that the running shell scans on demand (its inotify auto-watch is dead on
# this machine -- inotify-tools isn't installed -- so every mutation here
# ends with an explicit rescanPlugins call). Enabling one is a shell.json
# edit under the hood; this script drives that through the shell's own IPC
# methods (putBarWidget / enablePlugin) instead of hand-editing the file.

set -euo pipefail

PLUGINS_DIR="$HOME/.config/roseshell/plugins"

# Mirrors roseshell-restart-shell's own recovery: a caller's ambient ROSESHELL_PATH
# can be stale (an old terminal tab from before a project rename/move), so
# prefer what the running session actually registered.
session_roseshell_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^ROSESHELL_PATH=//p' | tail -n 1)
export ROSESHELL_PATH="${session_roseshell_path:-${ROSESHELL_PATH:-}}"

fail() { echo "roseshell-plugin: $1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage:
  roseshell-plugin add <git-url> [--enable] [--force]
                     [--section left|center|right] [--before <id>] [--after <id>]
  roseshell-plugin enable <id> [--section left|center|right] [--before <id>] [--after <id>]
  roseshell-plugin disable <id>
  roseshell-plugin remove <id>
  roseshell-plugin list

--section/--before/--after only matter for bar-widget plugins and are passed
straight through as placement hints; non-bar-widget plugins ignore them.
USAGE
}

require() { command -v "$1" >/dev/null 2>&1 || fail "'$1' is required but not installed"; }

rescan() { roseshell-shell -q shell rescanPlugins; }

# Reads manifest.json's "kinds" for an installed plugin and enables it the
# right way: bar-widget plugins go on the bar, everything else just gets
# switched on. Shared by `add --enable` and `enable`.
enable_plugin() {
  local id="$1" section="$2" before="$3" after="$4"
  local manifest="$PLUGINS_DIR/$id/manifest.json"
  [[ -f $manifest ]] || fail "no manifest.json for '$id' at $manifest"

  local placement="{}"
  if [[ -n $section || -n $before || -n $after ]]; then
    placement=$(jq -nc \
      --arg section "$section" --arg before "$before" --arg after "$after" \
      '{section:$section,before:$before,after:$after} | with_entries(select(.value != ""))')
  fi

  local is_bar_widget
  is_bar_widget=$(jq -r '(.kinds // []) | index("bar-widget") != null' "$manifest")

  local result
  if [[ $is_bar_widget == "true" ]]; then
    result=$(roseshell-shell shell putBarWidget "$id" "$placement")
  else
    result=$(roseshell-shell shell enablePlugin "$id" "$placement")
  fi

  [[ $result == "ok" ]] || fail "enabling '$id' failed: $result"
  echo "enabled $id"
}

cmd_add() {
  [[ $# -ge 1 ]] || fail "add requires a git URL"
  local url="$1"; shift
  local do_enable=0 force=0 section="" before="" after=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --enable) do_enable=1; shift ;;
      --force) force=1; shift ;;
      --section) section="$2"; shift 2 ;;
      --before) before="$2"; shift 2 ;;
      --after) after="$2"; shift 2 ;;
      *) fail "unknown flag '$1'" ;;
    esac
  done

  require git
  require jq
  mkdir -p "$PLUGINS_DIR"

  local staging
  staging=$(mktemp -d "$PLUGINS_DIR/.tmp-XXXXXX")
  trap 'rm -rf "$staging"' EXIT

  git clone --depth 1 "$url" "$staging" >&2

  [[ -f $staging/manifest.json ]] || fail "$url has no plugin/manifest.json at its root"
  local id
  id=$(jq -r '.id // empty' "$staging/manifest.json")
  [[ -n $id ]] || fail "manifest.json has no 'id' field"

  local dest="$PLUGINS_DIR/$id"
  if [[ -e $dest ]]; then
    [[ $force == 1 ]] || fail "'$id' is already installed at $dest (use --force to reinstall)"
    rm -rf "$dest"
  fi

  mv "$staging" "$dest"
  trap - EXIT
  echo "installed $id -> $dest"

  rescan
  sleep 0.3 # give the scan a moment before enabling references the fresh manifest
  [[ $do_enable == 1 ]] && enable_plugin "$id" "$section" "$before" "$after"
}

cmd_enable() {
  [[ $# -ge 1 ]] || fail "enable requires a plugin id"
  local id="$1"; shift
  local section="" before="" after=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --section) section="$2"; shift 2 ;;
      --before) before="$2"; shift 2 ;;
      --after) after="$2"; shift 2 ;;
      *) fail "unknown flag '$1'" ;;
    esac
  done
  require jq
  enable_plugin "$id" "$section" "$before" "$after"
}

cmd_disable() {
  [[ $# -eq 1 ]] || fail "disable requires exactly one plugin id"
  local result
  result=$(roseshell-shell shell setPluginEnabled "$1" false)
  [[ $result == "ok" ]] || fail "disabling '$1' failed: $result"
  echo "disabled $1"
}

cmd_remove() {
  [[ $# -eq 1 ]] || fail "remove requires exactly one plugin id"
  local id="$1"
  local dir="$PLUGINS_DIR/$id"
  [[ -d $dir ]] || fail "'$id' is not installed at $dir"
  roseshell-shell -q shell setPluginEnabled "$id" false >/dev/null || true
  rm -rf "$dir"
  rescan
  echo "removed $id"
}

cmd_list() {
  require jq
  roseshell-shell shell listPlugins | jq -r '
    (["ID","NAME","KINDS","ENABLED"] | @tsv),
    (.[] | [.id, .name, (.kinds | join(",")), (.enabled | tostring)] | @tsv)
  ' | column -t -s $'\t'
}

[[ $# -ge 1 ]] || { usage; exit 1; }
cmd="$1"; shift
case "$cmd" in
  add) cmd_add "$@" ;;
  enable) cmd_enable "$@" ;;
  disable) cmd_disable "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list "$@" ;;
  -h|--help) usage ;;
  *) usage; exit 1 ;;
esac
