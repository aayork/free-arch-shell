#!/bin/bash

# omarchy:summary=Apply current Omarchy theme accent color and Hyprland-flat radius to Zen Browser
# omarchy:hidden=true

# Zen exposes both as real about:config prefs (zen.theme.accent-color,
# zen.theme.border-radius, zen.theme.content-element-separation) rather than a
# userChrome.css hack, so this just rewrites those three lines in prefs.js --
# the same file Zen's own Settings UI would write to.
#
# Caveat: Firefox/Zen only reads prefs.js at startup and periodically flushes
# its own in-memory snapshot back over the file, discarding any prefs it
# didn't already know about. Editing this file while Zen is running plants
# the values on disk, but they only take (and survive future flushes) once
# Zen has been fully quit and relaunched.

CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
colors_toml="$CURRENT_THEME_DIR/colors.toml"
zen_profiles_ini="$HOME/.config/zen/profiles.ini"

[[ -f $colors_toml && -f $zen_profiles_ini ]] || exit 0

accent=$(grep -m1 '^accent' "$colors_toml" | sed -E 's/^accent[[:space:]]*=[[:space:]]*"(.*)"/\1/')
[[ -n $accent ]] || exit 0

# The install-level Default= (inside the [InstallXXXX] section) is what a
# bare `zen-browser` launch actually uses, which can differ from any
# [ProfileN] Default=1 marker.
zen_profile_rel=$(awk '
  /^\[Install/ { in_install=1; next }
  /^\[/        { in_install=0 }
  in_install && /^Default=/ { sub(/^Default=/, ""); print; exit }
' "$zen_profiles_ini")

if [[ -z $zen_profile_rel ]]; then
  zen_profile_rel=$(awk -F= '/^Path=/{p=$2} /^Default=1/{print p}' "$zen_profiles_ini")
fi

[[ -n $zen_profile_rel ]] || exit 0

zen_profile_dir="$HOME/.config/zen/$zen_profile_rel"
zen_prefs="$zen_profile_dir/prefs.js"
[[ -f $zen_prefs ]] || exit 0

# Ship the flat-chrome userChrome.css from the repo into the profile, and make
# sure Zen actually loads userChrome.css/userContent.css at all (off by default).
zen_chrome_dir="$zen_profile_dir/chrome"
mkdir -p "$zen_chrome_dir"
cp "$OMARCHY_PATH/config/zen/userChrome.css" "$zen_chrome_dir/userChrome.css"

set_pref() {
  local key="$1" value="$2"
  grep -q "\"$key\"" "$zen_prefs" && sed -i "/\"$key\"/d" "$zen_prefs"
  echo "user_pref(\"$key\", $value);" >>"$zen_prefs"
}

# Matches hyprland.lua's decoration.rounding = 0 (flat, TUI-inspired look).
set_pref "zen.theme.border-radius" "0"
# Loosely mirrors hyprland.lua's tight general.gaps_in/gaps_out.
set_pref "zen.theme.content-element-separation" "4"
set_pref "zen.theme.accent-color" "\"$accent\""
set_pref "toolkit.legacyUserProfileCustomizations.stylesheets" "true"
