#!/bin/bash

# roseshell:summary=Send the low battery warning notification and run battery-low hooks.
# roseshell:args=<percentage>
# roseshell:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: roseshell-battery-low <percentage>" >&2
  exit 1
fi

level=$1

roseshell-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
roseshell-hook battery-low "$level"
