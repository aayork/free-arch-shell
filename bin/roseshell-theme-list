#!/bin/bash

# roseshell:summary=List available themes
# roseshell:examples=roseshell theme list | roseshell theme set "Tokyo Night"

{
  find ~/.config/roseshell/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$ROSESHELL_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
