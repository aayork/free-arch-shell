#!/bin/bash

# roseshell:summary=Log out after closing application windows
# roseshell:examples=roseshell logout | roseshell system logout
# roseshell:aliases=roseshell logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

roseshell-osd -i logout -m "Logging out" -d 5000

# Now close all windows
roseshell-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
