#!/bin/bash

# roseshell:summary=Launch a TUI or focus an existing terminal window for it
# roseshell:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.roseshell.$(basename "$1")"
fi

LAUNCH_COMMAND="roseshell-launch-tui $@"

exec roseshell-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
