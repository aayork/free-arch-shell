#!/bin/bash

# roseshell:summary=Launch a floating terminal with the Roseshell presentation wrapper
# roseshell:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source roseshell-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="roseshell-show-logo; $cmd; code=\$?; if (( code != 130 )); then roseshell-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.roseshell.terminal --title=Roseshell -e bash -c "$presentation_script"
